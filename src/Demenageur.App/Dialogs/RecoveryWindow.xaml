<ui:FluentWindow x:Class="Demenageur.App.Dialogs.RecoveryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Reprise — Déménageur"
                 Width="480"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ResizeMode="NoResize">
    <StackPanel>
        <ui:TitleBar Title="Déménageur" ShowMaximize="False" ShowMinimize="False" ShowClose="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource LogoImage}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Margin="24,4,24,24" Orientation="Horizontal">
            <ui:ProgressRing Width="36" Height="36" IsIndeterminate="True" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Reprise d'une opération interrompue…" TextWrapping="Wrap" />
                <TextBlock x:Name="SoftwareText" Margin="0,4,0,0" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                           Text="Déménageur termine ou annule l'opération en cours au moment de l'arrêt. Ne ferme pas l'ordinateur." />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
