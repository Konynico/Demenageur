<ui:FluentWindow x:Class="Demenageur.App.Dialogs.OperationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Demenageur.App.ViewModels"
                 Title="{Binding Title}"
                 Width="860"
                 Height="760"
                 MinWidth="720"
                 MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource LogoImage}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,4,24,8">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding SourceText}" />
        </StackPanel>

        <!--  ① Destination et options  -->
        <ScrollViewer Grid.Row="2" Margin="24,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDestinationStep, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Disque de destination" />
                <ui:InfoBar Title="Aucun autre disque compatible" IsClosable="False" IsOpen="{Binding HasNoDestination}" Severity="Error"
                            Message="Il faut un autre disque interne en NTFS. Les disques USB, réseau et virtuels sont refusés." />
                <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" />
                <TextBlock Margin="0,10,0,4" Text="Dossier qui accueillera le logiciel :" />
                <ui:TextBox Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="Le logiciel sera copié dans un sous-dossier portant son nom. Ce dossier est créé avec des permissions réservées aux administrateurs." />

                <TextBlock Style="{StaticResource SectionTitle}" Text="Options" />
                <CheckBox Content="Créer un point de restauration Windows avant l'opération" IsChecked="{Binding CreateRestorePoint}" IsEnabled="{Binding RestorePointPossible}" />
                <ui:InfoBar Title="Protection système désactivée" Margin="0,6,0,0" IsClosable="False" Severity="Warning"
                            IsOpen="{Binding RestorePointImpossible, Mode=OneWay}"
                            Message="Windows ne peut pas créer de point de restauration tant que la protection système est désactivée sur le disque de Windows. Déménageur ne l'active jamais lui-même ; tu peux le faire dans le panneau Windows (cela réserve de l'espace sur C:)." />
                <ui:Button Margin="0,4,0,0" Command="{Binding OpenSystemProtectionCommand}" Content="Ouvrir « Protection du système »"
                           Visibility="{Binding RestorePointPossible, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Secondary}"
                           Text="Un point de restauration protège la configuration de Windows, pas les fichiers du logiciel : la vraie protection, c'est la vérification complète et l'annulation possible à tout moment." />
            </StackPanel>
        </ScrollViewer>

        <!--  ② Simulation et confirmation  -->
        <ScrollViewer Grid.Row="2" Margin="24,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSimulationStep, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ui:InfoBar Title="Simulation : rien n'a été modifié" IsClosable="False" IsOpen="True" Message="{Binding Summary}" Severity="Informational" />
                <ui:Button Margin="0,8,0,0" Command="{Binding OpenCopyCommand}" Content="Ouvrir la copie pour vérifier son contenu"
                           Visibility="{Binding IsRetire, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button.Icon>
                </ui:Button>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Vérifications" />
                <ItemsControl ItemTemplate="{StaticResource VerdictTemplate}" ItemsSource="{Binding Verdicts}" />

                <StackPanel Visibility="{Binding OfferExplorerOption, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Margin="0,8,0,0" Content="Arrêter l'Explorateur pendant l'opération, puis le relancer (la barre des tâches disparaît quelques instants)" IsChecked="{Binding StopExplorer}" />
                </StackPanel>
                <StackPanel Visibility="{Binding OfferServicesOption, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Margin="0,8,0,0" Content="Arrêter les services concernés pendant l'opération, puis les redémarrer" IsChecked="{Binding StopServices}" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Ce qui serait fait" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepLine}">
                            <StackPanel Margin="0,3">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,16,0,8" Padding="14" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8"
                        Visibility="{Binding PlanAllowsExecution, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Confirmation" />
                        <StackPanel Visibility="{Binding NeedsStrongConfirmation, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,6,0,4" TextWrapping="Wrap">
                                <Run Text="Confirmation renforcée : tape le nom exact du logiciel (" /><Run FontWeight="SemiBold" Text="{Binding ExpectedName, Mode=OneWay}" /><Run Text=") pour confirmer que tu as compris les avertissements ci-dessus." />
                            </TextBlock>
                            <ui:TextBox Text="{Binding TypedName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Margin="0,8,0,0" Content="J'ai lu la simulation et je comprends ce qui va être fait." IsChecked="{Binding Understood}" />
                        <ui:InfoBar Title="Mode « Simulation uniquement »" Margin="0,8,0,0" IsClosable="False" IsOpen="{Binding SimulationOnly}" Severity="Informational"
                                    Message="Les opérations réelles sont désactivées (Paramètres)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  ③ Exécution  -->
        <ScrollViewer Grid.Row="2" Margin="24,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsRunningStep, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentStep}" />
                <ProgressBar Height="8" Margin="0,8,0,4" Maximum="100" Value="{Binding Percent}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding ProgressDetail}" />

                <ui:InfoBar Title="Point de restauration non créé" Margin="0,12,0,0" IsClosable="False" IsOpen="{Binding AskRestorePointDecision}" Message="{Binding RestorePointMessage}" Severity="Warning" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding AskRestorePointDecision, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding RestorePointContinueCommand}" Content="Continuer sans" />
                    <ui:Button Command="{Binding RestorePointAbortCommand}" Content="Abandonner" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Étapes" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepLine}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="Icon" Grid.Column="0" FontSize="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Circle24" />
                                <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Title}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding State}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Icon" Property="Symbol" Value="CheckmarkCircle24" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="#107C10" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Icon" Property="Symbol" Value="ArrowSync24" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Secondary}"
                           Text="Ne débranche pas le disque et n'éteins pas l'ordinateur. En cas de coupure, relance Déménageur : il terminera ou annulera l'opération. Le bouton Annuler ramène tout à l'état initial tant que le point de non-retour n'est pas atteint." />
            </StackPanel>
        </ScrollViewer>

        <!--  ④ Résultat  -->
        <ScrollViewer Grid.Row="2" Margin="24,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="ResultIcon" FontSize="36" Foreground="#107C10" Symbol="CheckmarkCircle24"
                                   Visibility="{Binding ResultSuccess, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon FontSize="36" Foreground="#D86B00" Symbol="Warning24"
                                   Visibility="{Binding ResultSuccess, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding ResultTitle}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Paragraph}" Text="{Binding ResultMessage}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="À savoir" Visibility="{Binding Warnings, Converter={StaticResource NotEmptyToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2" Style="{StaticResource Secondary}" Text="{Binding StringFormat='• {0}'}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Secondary}" Text="Le détail de chaque étape est dans la page « Journal »." />
            </StackPanel>
        </ScrollViewer>

        <!--  Indicateur d'activité  -->
        <Border Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.92" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0" Text="{Binding BusyText}" />
            </StackPanel>
        </Border>

        <!--  Boutons  -->
        <Border Grid.Row="3" Padding="24,12" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <Grid>
                <ui:Button HorizontalAlignment="Left" Command="{Binding BackCommand}" Content="Retour"
                           Visibility="{Binding IsSimulationStep, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="Annuler"
                               Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                    <ui:Button Appearance="Primary" Command="{Binding SimulateCommand}" Content="Lancer la simulation"
                               Visibility="{Binding IsDestinationStep, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Primary" Command="{Binding ExecuteCommand}" Content="{Binding ExecuteLabel}" IsEnabled="{Binding CanExecuteOperation}"
                               Visibility="{Binding IsSimulationStep, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Primary" Command="{Binding CloseCommand}" Content="Fermer"
                               Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
