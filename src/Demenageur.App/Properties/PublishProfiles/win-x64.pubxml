<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication autonome (le runtime .NET est embarqué) : une app élevée qui dépendrait du runtime installé
  pourrait être détournée via DOTNET_ROOT. Pas d'extraction des bibliothèques natives dans %TEMP%
  (dossier modifiable par l'utilisateur) : elles restent à côté de l'exe, dans Program Files.
  Usage : dotnet publish src\Demenageur.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
