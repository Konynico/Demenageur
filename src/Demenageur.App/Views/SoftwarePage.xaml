<UserControl x:Class="Demenageur.App.Views.SoftwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Demenageur.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding LoadCommand}" Content="Actualiser">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Command="{Binding MoveFolderCommand}" Content="Déplacer un dossier…">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Logiciels installés" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,8" Orientation="Horizontal">
            <ui:TextBox Width="320" PlaceholderText="Rechercher (nom, éditeur, dossier)…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ComboBox Width="170" Margin="12,0,0,0" ItemsSource="{Binding DriveFilters}" SelectedItem="{Binding DriveFilter}" ToolTip="Filtrer par disque" />
            <CheckBox Margin="16,0,0,0" VerticalAlignment="Center" Content="Seulement les déplaçables" IsChecked="{Binding OnlyMovable}" />
            <CheckBox Margin="16,0,0,0" VerticalAlignment="Center" Content="Afficher les entrées masquées" IsChecked="{Binding ShowHidden}" />
            <CheckBox Margin="16,0,0,0" VerticalAlignment="Center" Content="Masquer les jeux des lanceurs" IsChecked="{Binding HideLauncherManaged}"
                      ToolTip="Steam, Epic, GOG, Ubisoft, Battle.net, Xbox, EA, Riot, Rockstar" />
        </WrapPanel>

        <!--  Liste  -->
        <Grid Grid.Row="2" Grid.Column="0">
            <DataGrid AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" GridLinesVisibility="None" HeadersVisibility="Column" IsReadOnly="True" ItemsSource="{Binding View}"
                      SelectedItem="{Binding Selected}" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="2*" Header="Nom" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:SoftwareItemViewModel}">
                                <StackPanel Margin="0,3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Publisher, Mode=OneWay}" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#8E6FD8" Text="{Binding LauncherText}" Visibility="{Binding IsLauncherManaged, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="90" Header="Taille" SortMemberPath="SizeSortKey">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:SoftwareItemViewModel}">
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Size, Converter={StaticResource Bytes}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="64" Binding="{Binding Drive}" Header="Disque" />
                    <DataGridTemplateColumn Width="160" Header="Statut" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:SoftwareItemViewModel}">
                                <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" Background="#1A107C10" CornerRadius="10">
                                    <TextBlock x:Name="BadgeText" FontSize="12" Foreground="#3FA33F" Text="{Binding StatusText}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="NeedsConfirmation">
                                        <Setter TargetName="Badge" Property="Background" Value="#26D86B00" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#F08A24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                        <Setter TargetName="Badge" Property="Background" Value="#26C42B1C" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#E8584A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="AlreadyMoved">
                                        <Setter TargetName="Badge" Property="Background" Value="#260F6CBD" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#4A9DE0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="UseLauncher">
                                        <Setter TargetName="Badge" Property="Background" Value="#268E6FD8" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#A58BE8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="UnknownFolder">
                                        <Setter TargetName="Badge" Property="Background" Value="#26808080" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#9A9A9A" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="3*" Header="Dossier" SortMemberPath="Folder">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:SoftwareItemViewModel}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.9" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding LoadingText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Détail  -->
        <ui:Card Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <Grid>
                <TextBlock Style="{StaticResource Secondary}" Text="Sélectionne un logiciel pour voir son analyse." Visibility="{Binding Selected, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=inverse}" />
                <ScrollViewer DataContext="{Binding Selected}" VerticalScrollBarVisibility="Auto" Visibility="{Binding Converter={StaticResource NotEmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Publisher}" />
                        <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Dossier" />
                        <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" />
                        <TextBlock Foreground="#D86B00" Text="{Binding FolderNote}" Visibility="{Binding FolderNote, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Statut" />
                        <TextBlock Text="{Binding StatusText}" />
                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Analyse" Visibility="{Binding Verdicts, Converter={StaticResource NotEmptyToVisibility}}" />
                        <ItemsControl ItemTemplate="{StaticResource VerdictTemplate}" ItemsSource="{Binding Verdicts}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Secondary}"
                                   Text="La simulation, lancée avant tout déplacement, refait une analyse complète (fichiers, processus, espace, disque cible)." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ui:Card>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,16,16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Command="{Binding ExcludeSelectedCommand}" Content="Exclure"
                       ToolTip="Ne jamais déplacer ce dossier avec Déménageur (réversible dans Paramètres)">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ShieldProhibited24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Appearance="Primary" Command="{Binding MoveSelectedCommand}" Content="Déplacer…">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
