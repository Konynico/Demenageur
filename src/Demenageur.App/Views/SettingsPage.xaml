<UserControl x:Class="Demenageur.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Paramètres" />

            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <ui:ToggleSwitch Content="Simulation uniquement (aucune opération réelle possible)" IsChecked="{Binding SimulationOnly}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="Pratique pour explorer l'application en toute sécurité : toutes les analyses restent disponibles." />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <ui:ToggleSwitch Content="Proposer un point de restauration avant chaque déplacement" IsChecked="{Binding RestorePointByDefault}" />
                    <TextBlock Margin="0,6,0,6" Style="{StaticResource Secondary}" Text="{Binding RestorePointText}" />
                    <ui:Button HorizontalAlignment="Left" Command="{Binding OpenSystemProtectionCommand}" Content="Ouvrir « Protection du système » (Windows)" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Dossier de destination sur chaque disque" />
                    <ui:TextBox Margin="0,6,0,0" Text="{Binding DestinationFolderName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="Exemple : D:\Logiciels déplacés\NomDuLogiciel. Créé par Déménageur avec des permissions réservées aux administrateurs (lecture pour les utilisateurs)." />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Dossiers exclus" />
                    <TextBlock Margin="0,4,0,6" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Text="Déménageur refuse de déplacer ces dossiers et tout ce qu'ils contiennent. Ajoute-en ici, ou avec le bouton « Exclure » de la liste des logiciels. Enregistré immédiatement." />
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <ui:Button DockPanel.Dock="Right" Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" ToolTip="Retirer de la liste">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Note}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding AddExclusionCommand}" Content="Ajouter un dossier…" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Lanceurs de jeux détectés" />
                    <TextBlock Margin="0,4,0,6" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Text="Les jeux de ces bibliothèques sont signalés dans la liste. Steam et l'application Xbox savent déplacer leurs jeux eux-mêmes : c'est la méthode à préférer." />
                    <ItemsControl FontFamily="Consolas" FontSize="12" ItemsSource="{Binding DetectedLaunchers}" />
                    <TextBlock Margin="0,4,0,6" Style="{StaticResource Secondary}" Text="{Binding LaunchersStatus}" TextWrapping="Wrap" />
                    <ui:Button HorizontalAlignment="Left" Command="{Binding ScanLaunchersCommand}" Content="Analyser" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Données de l'application" />
                    <TextBlock Margin="0,4,0,6" Style="{StaticResource Secondary}" Text="{Binding DataFolder}" />
                    <ui:Button HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}" Content="Ouvrir le dossier" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Text="Rien n'est envoyé sur Internet. Ce dossier, réservé aux administrateurs, contient les journaux des opérations (chemins, identifiants de fichiers, empreintes, permissions), nécessaires pour annuler un déplacement, et des logs techniques conservés 60 jours." />
                    <ui:Button Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding DeleteHistoryCommand}" Content="Effacer l'historique des opérations terminées…" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="{Binding HistoryMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="Enregistrer" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding SavedMessage}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
