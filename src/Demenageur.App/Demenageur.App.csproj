<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Demenageur.App</RootNamespace>
    <AssemblyName>Demenageur</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Demenageur.ico</ApplicationIcon>
    <BanDirectFileSystemAccess>true</BanDirectFileSystemAccess>
    <!-- App élevée : aucun code ne doit pouvoir être injecté au démarrage via DOTNET_STARTUP_HOOKS. -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- Release : ni débogueur, ni profileur, ni EventPipe attachables à ce processus élevé (défense en profondeur). -->
    <EnableDiagnostics Condition="'$(Configuration)' == 'Release'">false</EnableDiagnostics>
  </PropertyGroup>

  <!-- Compilation « aperçu » : interface sans élévation, simulation uniquement (développement). -->
  <PropertyGroup Condition="'$(DemenageurApercu)' == 'true'">
    <DefineConstants>$(DefineConstants);APERCU</DefineConstants>
    <ApplicationManifest>app.apercu.manifest</ApplicationManifest>
    <AssemblyName>Demenageur-Apercu</AssemblyName>
    <!-- Fichiers intermédiaires séparés : sinon le XAML compilé de la version normale (assemblage « Demenageur ») est réutilisé et l'aperçu plante au démarrage. -->
    <IntermediateOutputPath>obj\apercu\$(Configuration)\</IntermediateOutputPath>
    <OutputPath>bin\apercu\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Signature de code (audit E3) : inactive tant qu'aucun certificat n'est indiqué.
       dotnet publish ... -p:SignThumbprint=<empreinte SHA-1 du certificat installé> [-p:SignTool=<chemin de signtool.exe>] -->
  <Target Name="SignPublished" AfterTargets="Publish" Condition="'$(SignThumbprint)' != ''">
    <PropertyGroup>
      <SignTool Condition="'$(SignTool)' == ''">signtool</SignTool>
    </PropertyGroup>
    <Exec Command="&quot;$(SignTool)&quot; sign /sha1 $(SignThumbprint) /fd SHA256 /tr http://timestamp.digicert.com /td SHA256 /d Déménageur &quot;$(PublishDir)Demenageur.exe&quot;" />
    <Exec Command="&quot;$(SignTool)&quot; verify /pa &quot;$(PublishDir)Demenageur.exe&quot;" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Demenageur.Core\Demenageur.Core.csproj" />
    <ProjectReference Include="..\Demenageur.Windows\Demenageur.Windows.csproj" />
  </ItemGroup>

</Project>
