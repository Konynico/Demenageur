<ui:FluentWindow x:Class="Demenageur.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Demenageur.App"
                 xmlns:vm="clr-namespace:Demenageur.App.ViewModels"
                 xmlns:views="clr-namespace:Demenageur.App.Views"
                 Title="{Binding Title}"
                 Width="1280"
                 Height="820"
                 MinWidth="980"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:SoftwareListViewModel}">
            <views:SoftwarePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovesViewModel}">
            <views:MovesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JournalViewModel}">
            <views:JournalPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource LogoImage}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Navigation  -->
            <DockPanel Grid.Column="0" Margin="8,4,4,12">
                <StackPanel DockPanel.Dock="Top" Margin="12,4,0,16" Orientation="Horizontal">
                    <Image Width="30" Height="30" Source="{StaticResource LogoImage}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Déménageur" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageItem}">
                            <StackPanel Margin="4,6" Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="18" Symbol="{Binding Icon}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!--  Contenu  -->
            <Grid Grid.Column="1" Margin="4,0,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Bandeau des disques  -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                            <ui:Card Width="250" Margin="0,0,10,10" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="20" Symbol="Storage24" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold">
                                            <Run Text="{Binding Letter, Mode=OneWay}" />
                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Normal" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ProgressBar Height="6" Margin="0,8,0,4" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                                 Foreground="{Binding UsedRatio, Converter={StaticResource UsageToBrush}}" />
                                    <TextBlock FontSize="12" Text="{Binding FreeText}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" />
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Messages  -->
                <StackPanel Grid.Row="1">
                    <ui:InfoBar Title="Mode « Simulation uniquement »" Margin="0,0,0,8" IsClosable="False" IsOpen="{Binding IsSimulationOnly}" Severity="Informational"
                                Message="Aucune opération réelle n'est possible : seules les simulations sont autorisées (modifiable dans Paramètres)." />
                    <ItemsControl ItemsSource="{Binding StartupMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:InfoBar Title="Reprise après interruption" Margin="0,0,0,8" IsOpen="True" Message="{Binding}" Severity="Warning" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding SelectedPage.Page}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
