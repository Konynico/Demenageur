<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de Déménageur. Règles absolues :
    - uniquement des dossiers factices générés sous %TEMP%\DemenageurTests\<guid> ;
    - jamais en administrateur (le fixture d'assemblage refuse de démarrer sinon).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Demenageur.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Les opérations testées sont courtes : pas besoin de propager le jeton d'annulation de xUnit partout. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Demenageur.Core\Demenageur.Core.csproj" />
    <ProjectReference Include="..\..\src\Demenageur.Windows\Demenageur.Windows.csproj" />
    <ProjectReference Include="..\Demenageur.TestHost\Demenageur.TestHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
